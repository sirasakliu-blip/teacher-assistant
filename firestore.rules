rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin validation:
    // 1. Authenticated
    // 2. Email verified in Firebase Auth token
    // 3. Email ends with .ac.th
    // 4. Role in users/{uid} is 'admin'
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.matches('.*\\.ac\\.th$') &&
        getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() && (getUserData().role == 'teacher' || isAdmin());
    }

    // =========================================================================
    // 1. Admin Whitelist Collection
    // =========================================================================
    match /admin_whitelist/{email} {
      // Authenticated users can check whitelist status during registration
      allow get: if isAuthenticated();
      // Only validated Admins can list, add, modify, or delete
      allow list, create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 2. Teacher Invites Collection
    // =========================================================================
    match /teacher_invites/{code} {
      // Public single-document get for verifying invite code during teacher registration
      allow get: if true;

      // Only Admin can view all codes
      allow list: if isAdmin();

      // Only Admin can create or delete codes
      allow create, delete: if isAdmin();

      // Update allowed when consuming code during registration (isUsed false -> true and bound to auth.uid)
      allow update: if isAuthenticated() &&
        resource.data.isUsed == false &&
        request.resource.data.isUsed == true &&
        request.resource.data.usedByUid == request.auth.uid;
    }

    // =========================================================================
    // 3. Parent View Tokens Collection (Magic Link)
    // =========================================================================
    match /parent_view_tokens/{token} {
      // Read allowed for anyone with the token (no authentication required)
      allow read: if true;

      // Creation allowed by authenticated users (during registration or student generating link)
      allow create: if isAuthenticated();

      // Update and delete allowed for the owning student or admin
      allow update, delete: if isAuthenticated() &&
        (resource.data.studentUid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 4. Users Collection
    // =========================================================================
    match /users/{userId} {
      // Authenticated users can read profiles (classes, attendance lists, etc.)
      allow read: if isAuthenticated();

      // Create allowed for the authenticated owner
      allow create: if isUser(userId);

      // Update allowed for the owner or admin
      allow update: if isUser(userId) || isAdmin();

      // Delete allowed only for admin
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. Classes, Sessions, Attendance, Assignments, Submissions
    // =========================================================================
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /submissions/{submissionId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 6. Leave Requests (ระบบหนังสือราชการและใบลา TH Sarabun PSK)
    // =========================================================================
    match /leave_requests/{requestId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isTeacher();
    }
  }
}
