rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_whitelist/$(request.auth.token.email)))
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'teacher' || getUserData().role == 'admin')) ||
        isAdmin()
      );
    }

    // 1. ข้อมูลผู้ใช้และสิทธิ์ของครู/แอดมิน (Users)
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId) || isAdmin();
      allow update: if isUser(userId) || isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // 2. รหัสลงทะเบียนครู (Teacher Invites)
    match /teacher_invites/{code} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. จัดการสิทธิ์แอดมิน (Admin Whitelist)
    match /admin_whitelist/{email} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. ข้อมูลรายชื่อนักเรียน (Students)
    match /students/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. การผูกบัญชี LINE ของผู้ปกครองกับนักเรียน (Parent Bindings & LINE Links)
    match /parent_bindings/{lineUserId} {
      allow read, write: if true;
    }
    match /parent_line_links/{lineUserId} {
      allow read, write: if true;
    }
    match /parent_view_tokens/{token} {
      allow read, write: if true;
    }

    // 6. เช็กชื่อ / การเข้าเรียน / เซสชัน (Attendance, Sessions, Summaries)
    match /attendance/{docId} {
      allow read, write: if true;
    }
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /student_summaries/{studentUid} {
      allow read, write: if true;
    }

    // 7. การบ้าน / งานค้าง และการส่งงาน (Assignments & Submissions)
    match /assignments/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /submissions/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. แจ้งลาเรียน (Leave Requests)
    match /leave_requests/{docId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 9. ตารางเรียน & ห้องเรียน (Schedules & Classes)
    match /schedules/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /classes/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. ประกาศจากครู (Announcements)
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. ข้อมูลติดต่อครูประจำชั้น (Teachers)
    match /teachers/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
